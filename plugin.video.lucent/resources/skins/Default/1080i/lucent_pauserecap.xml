<?xml version="1.0" encoding="UTF-8"?>
<!-- "Je was hier gebleven": the last lines after a long pause (pauserecap.py) -->
<window type="dialog">
<defaultcontrol always="true">10</defaultcontrol>
<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation><animation effect="fade" end="0" time="200">WindowClose</animation>
<controls>
<control type="image"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture>lucent/white.png</texture><colordiffuse>CC000000</colordiffuse></control>
<control type="group"><left>260</left><top>250</top><width>1400</width><height>600</height>
<control type="label"><left>0</left><top>0</top><width>1400</width><height>34</height><font>font_caps</font><textcolor>lavender</textcolor><align>center</align><aligny>center</aligny><label>$INFO[Window.Property(kicker)]</label></control>
<control type="label"><left>0</left><top>46</top><width>1400</width><height>80</height><font>font_hero</font><textcolor>text</textcolor><align>center</align><aligny>center</aligny><label>$INFO[Window.Property(head)]</label></control>
<control type="group"><visible>String.IsEmpty(Window.Property(nolines))</visible><control type="label"><left>0</left><top>170</top><width>1400</width><height>56</height><font>font_body</font><textcolor>text3</textcolor><align>center</align><aligny>center</aligny><label>$INFO[Window.Property(line1)]</label></control><control type="label"><left>0</left><top>228</top><width>1400</width><height>56</height><font>font_body</font><textcolor>text2</textcolor><align>center</align><aligny>center</aligny><label>$INFO[Window.Property(line2)]</label></control><control type="label"><left>0</left><top>286</top><width>1400</width><height>56</height><font>font_label_bold</font><textcolor>text</textcolor><align>center</align><aligny>center</aligny><label>$INFO[Window.Property(line3)]</label></control></control>
<control type="label"><left>0</left><top>360</top><width>1400</width><height>34</height><font>font_tiny</font><textcolor>text3</textcolor><align>center</align><aligny>center</aligny><label>$INFO[Window.Property(where)]</label></control>
<control type="button" id="10"><left>450</left><top>440</top><width>240</width><height>64</height><font>font_label_bold</font><align>center</align><aligny>center</aligny><textcolor>text</textcolor><focusedcolor>on_focus</focusedcolor><texturefocus border="30" colordiffuse="focus">lucent/pill60.png</texturefocus><texturenofocus border="30" colordiffuse="glass_strong">lucent/pill60.png</texturenofocus><pulseonselect>false</pulseonselect><onright>11</onright><label>$INFO[Window.Property(go)]</label></control><control type="button" id="11"><left>710</left><top>440</top><width>240</width><height>64</height><font>font_label_bold</font><align>center</align><aligny>center</aligny><textcolor>text</textcolor><focusedcolor>on_focus</focusedcolor><texturefocus border="30" colordiffuse="focus">lucent/pill60.png</texturefocus><texturenofocus border="30" colordiffuse="glass_strong">lucent/pill60.png</texturenofocus><pulseonselect>false</pulseonselect><onleft>10</onleft><label>$INFO[Window.Property(back)]</label></control>
</control>
</controls>
</window>
