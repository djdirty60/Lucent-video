<?xml version="1.0" encoding="UTF-8"?>
<!-- "Blijf zitten": a scene during or after the credits of a film (credits.py) -->
<window type="dialog">
<defaultcontrol always="true">10</defaultcontrol>
<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation><animation effect="fade" end="0" time="200">WindowClose</animation>
<controls>
<control type="image"><left>0</left><top>520</top><width>1920</width><height>560</height><texture>lucent/grad_bottom.png</texture><colordiffuse>E6000000</colordiffuse></control>
<control type="group"><left>90</left><top>770</top><width>1740</width><height>230</height>
<control type="image"><left>-40</left><top>-40</top><width>1820</width><height>310</height><texture border="88">lucent/panel_shadow.png</texture><colordiffuse>B3000000</colordiffuse></control>
<control type="image"><left>0</left><top>0</top><width>1740</width><height>230</height><texture border="48">lucent/panel.png</texture><colordiffuse>panel</colordiffuse></control>
<control type="image"><left>0</left><top>0</top><width>1740</width><height>230</height><texture border="48">lucent/panel_edge.png</texture><colordiffuse>hairline</colordiffuse></control>
<control type="label"><left>50</left><top>34</top><width>1100</width><height>34</height><font>font_caps</font><textcolor>lavender</textcolor><aligny>center</aligny><label>$INFO[Window.Property(kicker)]</label></control>
