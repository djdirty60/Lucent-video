<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.lucent" version="1.0.0~beta1+40" name="Lucent Video" provider-name="Wilfried van der Voort">
    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="kodi.context.item">
        <menu id="kodi.core.main">
            <item library="context.py" args="source">
                <label>32130</label>
                <visible>String.Contains(ListItem.Path,plugin.video.lucent/library) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,episode)]</visible>
            </item>
            <item library="context.py" args="watched">
                <label>32131</label>
                <visible>String.Contains(ListItem.Path,plugin.video.lucent/library) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow) | String.IsEqual(ListItem.DBTYPE,episode)] + Integer.IsEqual(ListItem.PlayCount,0)</visible>
            </item>
            <item library="context.py" args="watched">
                <label>32132</label>
                <visible>String.Contains(ListItem.Path,plugin.video.lucent/library) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow) | String.IsEqual(ListItem.DBTYPE,episode)] + Integer.IsGreater(ListItem.PlayCount,0)</visible>
            </item>
            <item library="context.py" args="resume">
                <label>32299</label>
                <visible>String.Contains(ListItem.Path,plugin.video.lucent/library) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,episode)] + ListItem.IsResumable</visible>
            </item>
            <item library="context.py" args="watchlist_add">
                <label>32133</label>
                <visible>String.Contains(ListItem.Path,plugin.video.lucent/library) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow)]</visible>
            </item>
            <item library="context.py" args="watchlist_remove">
                <label>32134</label>
                <visible>String.Contains(ListItem.Path,plugin.video.lucent/library) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow)]</visible>
            </item>
            <item library="context.py" args="trailer">
                <label>32135</label>
                <visible>String.Contains(ListItem.Path,plugin.video.lucent/library) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow)] + !String.IsEmpty(ListItem.Trailer)</visible>
            </item>
            <item library="context.py" args="cast">
                <label>32136</label>
                <visible>String.Contains(ListItem.Path,plugin.video.lucent/library) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow)]</visible>
            </item>
            <item library="context.py" args="similar">
                <label>32137</label>
                <visible>String.Contains(ListItem.Path,plugin.video.lucent/library) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow)]</visible>
            </item>
            <item library="context.py" args="addwidget">
                <label>32175</label>
                <visible>ListItem.IsFolder + !ListItem.IsParentFolder + !Window.IsVisible(home) + System.HasAddon(skin.lucent) + !String.IsEmpty(Skin.String(nuvio.tab1.label)) + [String.StartsWith(ListItem.FolderPath,plugin://) | String.StartsWith(ListItem.Path,plugin://) | String.StartsWith(ListItem.FolderPath,videodb://) | String.StartsWith(ListItem.Path,videodb://) | String.StartsWith(ListItem.FolderPath,musicdb://) | String.StartsWith(ListItem.Path,musicdb://) | String.StartsWith(ListItem.FolderPath,library://) | String.StartsWith(ListItem.Path,library://) | String.StartsWith(ListItem.FolderPath,special://) | String.StartsWith(ListItem.Path,special://) | String.StartsWith(ListItem.FolderPath,addons://) | String.StartsWith(ListItem.Path,addons://) | String.StartsWith(ListItem.FolderPath,pvr://) | String.StartsWith(ListItem.Path,pvr://) | String.StartsWith(ListItem.FolderPath,sources://) | String.StartsWith(ListItem.Path,sources://)]</visible>
            </item>
            <item library="context.py" args="browseshow">
                <label>32176</label>
                <visible>String.IsEqual(ListItem.DBType,episode) + System.HasAddon(skin.lucent) + [!String.IsEmpty(ListItem.TvShowDBID) | [[String.StartsWith(ListItem.FileNameAndPath,plugin://) | String.StartsWith(ListItem.Path,plugin://)] + [!String.IsEmpty(ListItem.UniqueID(tmdb)) | !String.IsEmpty(ListItem.Property(tmdb_id))]]]</visible>
            </item>
            <item library="context.py" args="browseeps">
                <label>32177</label>
                <visible>String.IsEqual(ListItem.DBType,episode) + System.HasAddon(skin.lucent) + [!String.IsEmpty(ListItem.TvShowDBID) | [[String.StartsWith(ListItem.FileNameAndPath,plugin://) | String.StartsWith(ListItem.Path,plugin://)] + [!String.IsEmpty(ListItem.UniqueID(tmdb)) | !String.IsEmpty(ListItem.Property(tmdb_id))]]] + !String.IsEmpty(ListItem.Season)</visible>
            </item>
            <item library="context.py" args="addlib">
                <label>32178</label>
                <visible>[String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,tvshow)] + String.IsEmpty(ListItem.DBID) + [!String.IsEmpty(ListItem.Property(tmdb_id)) | !String.IsEmpty(ListItem.UniqueID(tmdb))] + String.IsEmpty(ListItem.Property(lucent_video)) + System.HasAddon(skin.lucent)</visible>
            </item>
            <item library="context.py" args="removelib">
                <label>32179</label>
                <visible>[String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,tvshow)] + [String.Contains(ListItem.Path,plugin.video.lucent/library) | String.Contains(ListItem.FolderPath,plugin.video.lucent/library)]</visible>
            </item>
            <item library="context.py" args="skiplib">
                <label>32186</label>
                <visible>[String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,season)] + [String.Contains(ListItem.Path,plugin.video.lucent/library) | String.Contains(ListItem.FolderPath,plugin.video.lucent/library) | String.Contains(ListItem.FileNameAndPath,plugin.video.lucent/library)]</visible>
            </item>
            <item library="context.py" args="rate">
                <label>32180</label>
                <visible>[String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,tvshow)] + [String.Contains(ListItem.Path,plugin.video.lucent/library) | String.Contains(ListItem.FolderPath,plugin.video.lucent/library)]</visible>
            </item>
        </menu>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Movies and series for Lucent, with AIOStreams and Trakt</summary>
        <summary lang="nl_NL">Films en series voor Lucent, met AIOStreams en Trakt</summary>
        <description lang="en_GB">Browse with TMDB, play through your own AIOStreams address and keep your progress on Trakt.</description>
        <description lang="nl_NL">Bladeren met TMDB, afspelen via je eigen AIOStreams-adres en je voortgang bijhouden op Trakt.</description>
        <platform>all</platform>
        <license>MIT</license>
        <news>1.0.0 beta 1, update 40: Settings > Account shows each account (Trakt, Simkl, PunchPlay) in its own block, with your choice and the shared options at the top.
1.0.0 beta 1, update 39: PunchPlay as a third account next to Trakt and Simkl (link with a code): scrobbling, resume points, watchlist, own lists, Continue watching and Next episode; it can also be your second account. Copy your library now works between Trakt, Simkl and PunchPlay in any direction.
1.0.0 beta 1, update 38: Kodi could crash after update 37; Kodi no longer keeps Python running between calls (that mode is off again). The other improvements of update 37 stay.
1.0.0 beta 1, update 37: menus and widgets load up to three times faster (Kodi reuses Python instead of starting it for every list); the service loads the source search and the phone remote only when needed; a new preferred subtitle language counts within a minute instead of after a restart.
1.0.0 beta 1, update 36: Continue watching shows each film and episode only once; Trakt sometimes kept two progress points for the same film (started twice or on two devices), now only the newest counts.
1.0.0 beta 1, update 35: titles taken from Trakt use Trakt's translation in your language when there is one (as Seren does), else the English title.
1.0.0 beta 1, update 34: when TMDB only has 'Episode 7' (in English too), the title and description come from Trakt, like Seren; also without a Trakt account, in lists and in the library.</news>
        <news lang="nl_NL">1.0.0 beta 1, update 40: Accounts netjes per blok: Onder Instellingen &gt; Account heeft elk account nu een eigen blok: bovenaan je keuze, 'Ook bijwerken bij je andere account' en 'Bibliotheek kopiëren', daaronder Trakt, Simkl en PunchPlay, elk met koppelen, accountinformatie en loskoppelen.
1.0.0 beta 1, update 39: PunchPlay als account: Naast Trakt en Simkl kun je nu ook je gratis PunchPlay-account koppelen (Instellingen &gt; Account), met een code op je telefoon. Lucent geeft door wat je kijkt en waar je stopt, en haalt je kijklijst, je eigen lijsten, Verder kijken en Volgende aflevering bij PunchPlay. Ben je ook bij Trakt of Simkl ingelogd, dan kan alles naar beide gaan. Bibliotheek kopiëren tussen alle accounts: Bibliotheek kopiëren werkt nu tussen Trakt, Simkl en PunchPlay, in elke richting. Wat het andere account al heeft, slaat Lucent over; er wordt niets verwijderd.
1.0.0 beta 1, update 38: Kodi loopt niet meer vast: Update 37 liet Kodi Python laten doordraaien om menu's sneller te laden. Daardoor kon Kodi vastlopen. Die stand staat weer uit; de andere verbeteringen van update 37 blijven.</news>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
</addons>
